# ===================================================================
# Taskora Spring Boot Configuration Example Template
# Copy this file to application.properties and customize your MySQL credentials
# ===================================================================
server.port=8080

# Database URL: Replace localhost:3306 with your MySQL host and port if different
spring.datasource.url=jdbc:mysql://localhost:3306/taskora?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Replace with your MySQL username (usually root)
spring.datasource.username=root

# Replace with your MySQL password
spring.datasource.password=your_mysql_password_here

spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Hibernate DDL auto: 'update' will create/update tables without dropping existing data
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
